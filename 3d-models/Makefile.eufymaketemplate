SOURCE=eufymaketemplate.scad
DEPENDS=hsu.scad Makefile.eufymaketemplate
IMAGES=
ALL=eufymaketemplate.stl eufymaketemplatesplit.stl eufymaketemplateround.stl eufymaketemplaterectangle.stl eufymaketemplate65x65.stl eufymaketemplate55x55.stl eufymaketemplate55x75.stl eufymaketemplate55x95.stl 

OPENSCADOPTIONS=-D debug=0 --backend=manifold --enable textmetrics

all: $(ALL)

dist: eufymaketemplate.zip

eufymaketemplate-source-distribution.zip: $(SOURCE) $(DEPENDS)
	rm -rf eufymaketemplate-distribution
	rm -f eufymaketemplate-distribution.zip
	mkdir -p eufymaketemplate-distribution
	cp $(SOURCE) $(DEPENDS) eufymaketemplate-distribution
	zip -r $@ eufymaketemplate-distribution
	echo $@ built.      

eufymaketemplate-full-distribution.zip: $(ALL) $(SOURCE) $(DEPENDS) $(IMAGES)
	rm -rf eufymaketemplate-distribution
	rm -f eufymaketemplate-distribution.zip
	mkdir -p eufymaketemplate-distribution
	cp $(ALL) $(SOURCE) $(DEPENDS) $(IMAGES) eufymaketemplate-distribution
	zip -r $@ eufymaketemplate-distribution
	echo $@ built.      

clean:
	rm $(ALL)

eufymaketemplate.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=1 -o $@ $(SOURCE)
	echo $@ built.

eufymaketemplatesplit.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=2 -o $@ $(SOURCE)
	echo $@ built.

eufymaketemplateround.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=3 -o $@ $(SOURCE)
	echo $@ built.

eufymaketemplaterectangle.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=4 -o $@ $(SOURCE)
	echo $@ built.

eufymaketemplate65x65.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=5 -o $@ $(SOURCE)
	echo $@ built.

eufymaketemplate55x55.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=6 -o $@ $(SOURCE)
	echo $@ built.

eufymaketemplate55x75.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=7 -o $@ $(SOURCE)
	echo $@ built.

eufymaketemplate55x95.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=8 -o $@ $(SOURCE)
	echo $@ built.

