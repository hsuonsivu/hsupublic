SOURCE=case2diskholder.scad
DEPENDS=hsu.scad Makefile.case2diskholder
IMAGES=
ALL=case2diskholder.stl case2diskholderbase.stl case2diskholdertop.stl case2diskholderclips.stl case2diskholderdiskclips.stl case2diskholdertopandclips.stl case2diskholderbaseanddiskclips.stl case2diskholdercover.stl case2diskholdercoverclips.stl case2diskholdercoverandcoverclips.stl

OPENSCADOPTIONS=-D debug=0 --backend=manifold --enable textmetrics

all: $(ALL)

dist: case2diskholder.zip

case2diskholder-source-distribution.zip: $(SOURCE) $(DEPENDS)
	rm -rf case2diskholder-distribution
	rm -f case2diskholder-distribution.zip
	mkdir -p case2diskholder-distribution
	cp $(SOURCE) $(DEPENDS) case2diskholder-distribution
	zip -r $@ case2diskholder-distribution
	echo $@ built.      

case2diskholder-full-distribution.zip: $(ALL) $(SOURCE) $(DEPENDS) $(IMAGES)
	rm -rf case2diskholder-distribution
	rm -f case2diskholder-distribution.zip
	mkdir -p case2diskholder-distribution
	cp $(ALL) $(SOURCE) $(DEPENDS) $(IMAGES) case2diskholder-distribution
	zip -r $@ case2diskholder-distribution
	echo $@ built.      

clean:
	rm $(ALL)

case2diskholderbase.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=1 -o $@ $(SOURCE)
	echo $@ built.

case2diskholdertop.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=2 -o $@ $(SOURCE)
	echo $@ built.

case2diskholderclips.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=3 -o $@ $(SOURCE)
	echo $@ built.

case2diskholderdiskclips.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=4 -o $@ $(SOURCE)
	echo $@ built.

case2diskholdercover.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=8 -o $@ $(SOURCE)
	echo $@ built.

case2diskholdercoverclips.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=9 -o $@ $(SOURCE)
	echo $@ built.

case2diskholdertopandclips.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=12 -o $@ $(SOURCE)
	echo $@ built.

case2diskholderbaseanddiskclips.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=13 -o $@ $(SOURCE)
	echo $@ built.

case2diskholdercoverandcoverclips.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D print=10 -o $@ $(SOURCE)
	echo $@ built.

