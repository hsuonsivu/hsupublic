SOURCE=sportstabletholder.scad
DEPENDS=hsu.scad Makefile.sportstabletholder
IMAGES=
TUNTURICROSSTRAINER=tunturicrosstrainer.stl tunturicrosstrainerbase.stl tunturicrosstrainertop.stl
WATERROWER=waterrowertop.stl waterrowerattach.stl waterrowerbolts.stl waterrowerbinder.stl waterrowerright.stl waterrowerleft.stl bolttest.stl
ALL=$(TUNTURICROSSTRAINER) $(WATERROWER)

OPENSCADOPTIONS=-D debug=0 --backend=manifold --enable textmetrics

tunturicrosstrainer: $(TUNTURICROSSTRAINER)

waterrower: $(WATERROWER)

all: $(ALL)

dist: sportstabletholder.zip

sportstabletholder-source-distribution.zip: $(SOURCE) $(DEPENDS)
	rm -rf sportstabletholder-distribution
	rm -f sportstabletholder-distribution.zip
	mkdir -p sportstabletholder-distribution
	cp $(SOURCE) $(DEPENDS) sportstabletholder-distribution
	zip -r $@ sportstabletholder-distribution
	echo $@ built.      

sportstabletholder-full-distribution.zip: $(ALL) $(SOURCE) $(DEPENDS) $(IMAGES)
	rm -rf sportstabletholder-distribution
	rm -f sportstabletholder-distribution.zip
	mkdir -p sportstabletholder-distribution
	cp $(ALL) $(SOURCE) $(DEPENDS) $(IMAGES) sportstabletholder-distribution
	zip -r $@ sportstabletholder-distribution
	echo $@ built.      

clean:
	rm $(ALL)

tunturicrosstrainerbase.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=1 -Dwaterrowerversion=0 -D print=1 -o $@ $(SOURCE)
	echo $@ built.

tunturicrosstrainertop.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=1 -Dwaterrowerversion=0  -D print=2 -o $@ $(SOURCE)
	echo $@ built.

tunturicrosstrainer.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=1 -Dwaterrowerversion=0  -D print=3 -o $@ $(SOURCE)
	echo $@ built.

waterrowertop.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=0 -Dwaterrowerversion=1  -D print=2 -o $@ $(SOURCE)
	echo $@ built.

waterrowerattach.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=0 -Dwaterrowerversion=1  -D print=4 -o $@ $(SOURCE)
	echo $@ built.

waterrowerbolts.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=0 -Dwaterrowerversion=1  -D print=5 -o $@ $(SOURCE)
	echo $@ built.

waterrowerbinder.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=0 -Dwaterrowerversion=1  -D print=6 -o $@ $(SOURCE)
	echo $@ built.

waterrowerright.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=0 -Dwaterrowerversion=1  -D print=8 -o $@ $(SOURCE)
	echo $@ built.

waterrowerleft.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=0 -Dwaterrowerversion=1  -D print=9 -o $@ $(SOURCE)
	echo $@ built.


bolttest.stl: $(SOURCE) $(DEPENDS)
	openscad $(OPENSCADOPTIONS) -D tunturicrosstrainerversion=0 -Dwaterrowerversion=1  -D print=20 -o $@ $(SOURCE)
	echo $@ built.